---
// Basis-Layout (SPEC §5, §9). Setzt die data-*-Testschnittstelle am <html>
// und bettet das Archetyp-/Nie-Scroll-Skript inline vor dem Paint ein.
import viewportScript from '../client/viewport.js?raw';
import AgentHead from '../components/AgentHead.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  intent?: string; // SPEC §2, P2: data-intent für Testschnittstelle (§10)
}

const { lang, title, description = '', intent } = Astro.props;
---

<!doctype html>
<html lang={lang} data-archetype="portrait" data-tier="1" data-webgl="false" data-intent={intent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <AgentHead lang={lang} />
    <link rel="icon" href="data:," />
    <script is:inline set:html={viewportScript}></script>
  </head>
  <body>
    <slot />
    <script is:inline>
      // E-Mail-Aufwertung: obfuskierte Teile → echtes mailto (Progressive Enhancement).
      (function () {
        document.querySelectorAll('a.email[data-u][data-d]').forEach(function (a) {
          var addr = a.getAttribute('data-u') + '@' + a.getAttribute('data-d');
          a.setAttribute('href', 'mailto:' + addr);
          var text = a.querySelector('.email-text');
          if (text) text.textContent = addr;
        });
      })();
    </script>
  </body>
</html>
