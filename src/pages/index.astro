---
// Startsicht (SPEC §2, §3, §5). Zeigt T0 + Intent-Auswahl (SPEC §2, ADR-004).
// T1/T2-Inhalte liegen auf den Intent-Routen /hire /collab /curious /learn.
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import IntentSearch from '../components/IntentSearch.astro';
import { profile, intents } from '../lib/content';
import { resolveLang, t } from '../lib/i18n';

const lang = resolveLang(Astro.url.searchParams.get('lang'));
const otherLang = lang === 'de' ? 'en' : 'de';

const p = profile.person;
const name = p.name;
const role = t(p.role, lang);
const tagline = t(p.tagline, lang);
const location = p.location;

const primaryLinks = p.links.primary
  .map((key) => ({ key, url: p.links.all[key] }))
  .filter((l) => Boolean(l.url));

const clickableIntents = intents.filter((i) => i.clickable);

const title = `${name} — ${role}`;
const base = import.meta.env.BASE_URL;

const labels = {
  de: { primary: 'Primärlinks', intents: 'Was bringt dich her?' },
  en: { primary: 'Primary links', intents: 'What brings you here?' },
}[lang];
---

<Base lang={lang} title={title} description={role} intent="start">
  <div class="stage">
    <figure class="figure" aria-hidden="true"><Figure /></figure>

    <main class="content">
      <h1 class="name">{name}</h1>
      <p class="role">{role}</p>
      {tagline && <p class="tagline essence-extra">{tagline}</p>}
      <p class="location essence-extra">{location}</p>

      {/* Intent-Auswahl: echte Links — No-JS-fähig (SPEC §2, ADR-004). Tab-Order: Auswahl → Links → Freitext (§10). */}
      <nav class="intent-nav" aria-label={labels.intents}>
        {
          clickableIntents.map((intent) => {
            const label = t(intent.label, lang);
            return (
              <a class="intent-link" href={`${base}${intent.id}/`}>
                {label}
              </a>
            );
          })
        }
      </nav>

      <nav class="links links-inline" aria-label={labels.primary}>
        {
          primaryLinks.map((l, i) => (
            <a class:list={['link', { 'link-secondary': i > 0 }]} href={l.url} rel="me">
              {l.key}
            </a>
          ))
        }
      </nav>

      <IntentSearch lang={lang} base={base} />
    </main>

    <a class="lang-toggle" href={`?lang=${otherLang}`} hreflang={otherLang} rel="alternate">
      {otherLang.toUpperCase()}
    </a>
  </div>
</Base>

